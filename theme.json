					"fontWeight": "600",
					"lineHeight": "1.2",
					"letterSpacing": "0"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--60)",
						"bottom": "var(--wp--preset--spacing--60)",
						"left": "var(--wp--preset--spacing--60)",
						"right": "var(--wp--preset--spacing--60)"
					},
					"margin": {
						"top": "var(--wp--preset--spacing--70)",
						"bottom": "var(--wp--preset--spacing--70)"
					}
				},
				"elements": {
					"link": {
						"color": {
							"text": "currentColor"
						}
					}
				}
			},
			"core/quote": {
				"border": {
					"top": {
						"color": "var(--wp--preset--color--ink)",
						"style": "solid",
						"width": "2px"
					},
					"bottom": {
						"color": "var(--wp--preset--color--ink)",
						"style": "solid",
						"width": "2px"
					},
					"left": {
						"width": "0px",
						"style": "none"
					}
				},
				"typography": {
					"fontStyle": "normal",
					"fontSize": "1.375rem",
					"lineHeight": "1.4"
				},
				"spacing": {
					"padding": {
						"top": "var(--wp--preset--spacing--50)",
						"bottom": "var(--wp--preset--spacing--50)",
						"left": "0",
						"right": "0"
					},
					"margin": {
