						"bottom": "var(--wp--preset--spacing--70)"
					}
				}
			},
			"core/separator": {
				"color": {
					"text": "var(--wp--preset--color--ink)"
				}
			},
			"core/code": {
				"color": {
					"background": "var(--wp--preset--color--deep)",
