			"spacingSizes": [
				{
					"slug": "10",
					"name": "s1 - 0.25rem",
					"size": "0.25rem"
				},
				{
					"slug": "20",
					"name": "s2 - 0.5rem",
					"size": "0.5rem"
				},
				{
					"slug": "30",
					"name": "s3 - 0.75rem",
					"size": "0.75rem"
				},
				{
					"slug": "40",
					"name": "s4 - 1rem",
					"size": "1rem"
