			"color": true,
			"radius": false,
			"style": true,
			"width": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": []
		},
		"custom": {
			"gutter": "clamp(1.25rem, 0.5rem + 3vw, 3rem)",
			"measure": "42rem",
			"lead-measure": "34ch",
			"narrow-measure": "28ch",
			"dialog-width": "44rem",
			"target": "2.75rem",
			"field-target": "3rem",
			"bp-nav": "40em",
			"bp-stack": "48em",
			"bp-grid": "64em"
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--paper)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--grotesque)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.65",
			"fontWeight": "400"
		},
		"spacing": {
			"padding": {
				"top": "0",
				"bottom": "0",
				"left": "var(--wp--custom--gutter)",
				"right": "var(--wp--custom--gutter)"
			},
			"blockGap": "var(--wp--preset--spacing--50)"
		},
		"elements": {
			"link": {
				"color": {
					"text": "currentColor"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--on-pop)",
						"background": "var(--wp--preset--color--pop)"
					},
					"typography": {
						"textDecoration": "underline"
					}
				}
			},
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--grotesque)",
					"fontWeight": "700",
					"lineHeight": "1.05",
					"letterSpacing": "-0.03em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-1)",
					"lineHeight": "1.02"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-2)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-3)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-4)",
					"lineHeight": "1.15",
					"letterSpacing": "-0.03em"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-5)",
					"lineHeight": "1.25",
					"letterSpacing": "-0.02em"
				}
			},
			"h6": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "0.875rem",
					"lineHeight": "1.5",
					"letterSpacing": "0.12em",
					"textTransform": "uppercase"
				}
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--pop)",
					"text": "var(--wp--preset--color--on-pop)"
				},
				"border": {
					"radius": "0px",
					"color": "var(--wp--preset--color--ink)",
					"style": "solid",
					"width": "2px"
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--mono)",
					"fontSize": "var(--wp--preset--font-size--label)",
					"fontWeight": "500",
					"letterSpacing": "0.14em",
					"textTransform": "uppercase",
					"textDecoration": "none",
					"lineHeight": "1.5"
				},
				"spacing": {
					"padding": {
						"top": "0.5rem",
						"bottom": "0.5rem",
						"left": "1.5rem",
						"right": "1.5rem"
					}
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--pop)",
						"text": "var(--wp--preset--color--on-pop)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--pop)",
						"text": "var(--wp--preset--color--on-pop)"
					}
				},
				":active": {
					"color": {
						"background": "var(--wp--preset--color--pop)",
						"text": "var(--wp--preset--color--on-pop)"
					}
				}
			}
		},
		"blocks": {
			"core/post-content": {
				"elements": {
					"link": {
						":visited": {
							"color": {
								"text": "var(--wp--preset--color--muted)"
